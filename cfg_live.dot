digraph CFG {
  node [shape=box];
  B0 [label="B0: skip\nIN = {\"y\"}\nOUT = {\"y\"}\n(exit)"];
  B1 [label="B1: y := (b + x)\nIN = {\"b\", \"x\"}\nOUT = {\"y\"}"];
  B2 [label="B2: unused := 100\nIN = {\"b\", \"x\"}\nOUT = {\"b\", \"x\"}"];
  B3 [label="B3: b := (a * 4)\nIN = {\"a\", \"x\"}\nOUT = {\"b\", \"x\"}"];
  B4 [label="B4: a := (2 + 3)\nIN = {\"x\"}\nOUT = {\"a\", \"x\"}\n(entry)"];
  B1 -> B0;
  B2 -> B1;
  B3 -> B2;
  B4 -> B3;
}
