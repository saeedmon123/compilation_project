digraph CFG {
  node [shape=box];
  B0 [label="B0: skip\nIN = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }, Assignment { variable: \"unused\", block: 2 }, Assignment { variable: \"y\", block: 1 }}\nOUT = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }, Assignment { variable: \"unused\", block: 2 }, Assignment { variable: \"y\", block: 1 }}\n(exit)"];
  B1 [label="B1: y := (b + x)\nIN = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }, Assignment { variable: \"unused\", block: 2 }}\nOUT = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }, Assignment { variable: \"unused\", block: 2 }, Assignment { variable: \"y\", block: 1 }}"];
  B2 [label="B2: unused := 100\nIN = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }}\nOUT = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }, Assignment { variable: \"unused\", block: 2 }}"];
  B3 [label="B3: b := (a * 4)\nIN = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }}\nOUT = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }, Assignment { variable: \"b\", block: 3 }}"];
  B4 [label="B4: a := (2 + 3)\nIN = {Input(\"x\")}\nOUT = {Input(\"x\"), Assignment { variable: \"a\", block: 4 }}\n(entry)"];
  B1 -> B0;
  B2 -> B1;
  B3 -> B2;
  B4 -> B3;
}
