digraph CFG {
  node [shape=box];
  B0 [label="B0: skip\\n(exit)"];
  B1 [label="B1: guard (y < x)"];
  B2 [label="B2: y := (y + 1)"];
  B3 [label="B3: y := (y + 2)"];
  B4 [label="B4: guard (y < 5)"];
  B5 [label="B5: y := 0\\n(entry)"];
  B1 -> B4 [label="true"];
  B1 -> B0 [label="false"];
  B2 -> B1;
  B3 -> B1;
  B4 -> B2 [label="true"];
  B4 -> B3 [label="false"];
  B5 -> B1;
}
